{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"outDir": "./dist/modules",
		"declaration": true,
		"declarationMap": true,
		"stripInternal": true,
		"composite": true,
		"noEmit": false,
		"moduleResolution": "nodenext",
		"module": "nodenext",
		"allowJs": false,
		"paths": { "mediabunny": ["../../src/index.ts"] }
	},
	"include": ["./src/**/*"],
	"references": [{ "path": "../../src" }]
}
